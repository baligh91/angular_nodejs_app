NODE_ENV=development
PORT=3000
MONGODB_URI=mongodb://127.0.0.1:27017/fml?replicaSet=rs0
JWT_SECRET=replace-with-at-least-32-random-characters
APP_ORIGIN=http://localhost:4200
SYNC_ENABLED=true
FPL_BASE_URL=https://fantasy.premierleague.com/api/
COOKIE_SECURE=false
# Explicit operator-managed admin identities; every identity still proves FPL ownership.
# ADMIN_FPL_IDS=123456,789012
# Production requires HTTPS APP_ORIGIN/FPL_BASE_URL and always enables secure cookies.
